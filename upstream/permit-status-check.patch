new file mode 100755
index 0000000..cd9b307
--- /dev/null
+++ b/skills/permit-status-check/scripts/preview.py
@@ -0,0 +1,45 @@
+#!/usr/bin/env python3
+import argparse, hashlib, json, re
+from pathlib import Path
+
+STATUS = ["received", "in_review", "approved", "denied", "correction_required", "unknown"]
+INSPECTION = ["not_required", "not_ready", "ready_to_schedule", "scheduled", "unknown"]
+ACTIONS = ["wait_for_review", "submit_correction", "provide_document", "schedule_inspection", "contact_reviewer", "human_review", "none"]
+
+def mask_phone(value):
+    digits = re.sub(r"\D", "", value)
+    return "+***" + digits[-4:] if len(digits) >= 4 else "***"
+
+def main():
+    ap = argparse.ArgumentParser(description="No-call permit status preview")
+    ap.add_argument("--request", required=True)
+    args = ap.parse_args()
+    req = json.loads(Path(args.request).read_text())
+    if req.get("authorized") is not True:
+        raise SystemExit("refused: authorized must be true")
+    phone = str(req.get("to_phone_e164", ""))
+    if not re.fullmatch(r"\+\d{8,15}", phone):
+        raise SystemExit("refused: to_phone_e164 must be E.164")
+    task = (
+        f"You are an AI project-coordination assistant calling on behalf of {req['company_name']}. "
+        "Disclose immediately that you are an AI assistant and not a government official. "
+        f"Ask only about permit {req['permit_number']} for {req['project_name']} at {req['project_address']} in {req['jurisdiction']}. "
+        "Determine current permit status, any missing correction or document, inspection readiness, any date the office volunteers, department/contact, and the smallest administrative next action. "
+        "Do not make legal or code-compliance claims, pay fees, submit documents, schedule or cancel an inspection, or make commitments. Stop if asked. Record unknown instead of guessing."
+    )
+    material = "|".join(str(req[k]).strip() for k in ["request_id", "company_name", "permit_number", "project_address", "jurisdiction", "to_phone_e164", "region", "locale"])
+    key = "permit_status:" + hashlib.sha256(material.encode()).hexdigest()[:32]
+    schema = {
+        "permit_status": STATUS,
+        "missing_items": "string",
+        "inspection_status": INSPECTION,
+        "next_available_date": "YYYY-MM-DD or empty",
+        "next_action": ACTIONS,
+        "department_or_contact": "string",
+        "follow_up_requested": "boolean",
+        "notes": "string"
+    }
+    print(json.dumps({"status": "not_called", "recipient": mask_phone(phone), "task": task, "result_schema": schema, "idempotency_key": key}, indent=2))
+
+if __name__ == "__main__":
+    main()
